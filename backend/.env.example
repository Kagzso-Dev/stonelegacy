# Backend (Express.js)
PORT=5000
FRONTEND_URL=http://localhost:8006

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=stonelegacy

# JWT
JWT_SECRET=your_super_secret_key_here
